# ══════════════════════════════════════════════════════════════
# Clean Select — configuração central (edite à vontade)
# Formato KEY=VALOR. Variável de ambiente real sobrescreve este arquivo.
# ══════════════════════════════════════════════════════════════

# ── MEMÓRIA / ESCALONAMENTO ─────────────────────────────────────
# memória "boa": usado <= 80%  (= livre >= 20%)
CS_FREE_OK_PCT=20
# emergência: usado > 90%  (= livre < 10%)
CS_FREE_EMERGENCY_PCT=10
# meta: o daemon limpa até o livre chegar aqui
CS_FREE_TARGET_PCT=30

# ── DAEMON ────────────────────────────────────────────────────
# verifica o espaço a cada N minutos
CS_CHECK_MIN=30
# limpeza completa a cada N horas (quando o espaço está folgado)
CS_RUN_HOURS=24

# ── VARREDURA ─────────────────────────────────────────────────
# concorrência do scanner (fs.opendir)
CS_SCAN_CONCURRENCY=16
# ignora arquivos modificados há menos de N segundos
CS_MIN_FILE_AGE_SEC=60
# idade mínima padrão dos alvos, em dias
CS_AGE_DAYS=3

# ── LIXEIRA / LOG ─────────────────────────────────────────────
# dias até a lixeira esvaziar sozinha
CS_TRASH_DAYS=7
# tamanho máximo do log antes de rotacionar (MB)
CS_LOG_MAX_MB=5

# ── DEDUPE ────────────────────────────────────────────────────
# ignora arquivos menores que N KB
CS_DEDUPE_MIN_KB=4
# tamanho do hash parcial (primeiros+últimos N KB)
CS_DEDUPE_PARTIAL_KB=64

# ── FUSÍVEIS DE SEGURANÇA ─────────────────────────────────────
# aborta se uma execução for apagar mais de N GB
CS_FUSE_MAX_GB=5
# ... ou mais de N% dos arquivos escaneados
CS_FUSE_MAX_PCT=20

# ── RELATÓRIOS ────────────────────────────────────────────────
# itens por categoria no relatório
CS_TOP_N=10
# alerta de crescimento: pasta que cresceu +N MB em 7 dias
CS_GROWTH_ALERT_MB=500
# onde o relatório semanal é gravado
CS_REPORT_FILE=/sdcard/Download/clean_select_relatorio.txt

# ── PATHS ─────────────────────────────────────────────────────
# raiz varrida (o daemon/scan usam /sdcard no celular)
CS_ROOT=/sdcard
# casa do estado (lixeira, histórico, index, lock, heartbeat)
# CLEAN_SELECT_HOME=~/.clean_select

# ── TELEGRAM REMOTO (opcional, desativado sem token) ───────────
# CLEAN_SELECT_TG_TOKEN=
# CLEAN_SELECT_TG_CHAT=
